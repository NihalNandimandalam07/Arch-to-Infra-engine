# Copy to backend.hcl (gitignored). Generate the values with:
#   terraform -chdir=bootstrap output -raw backend_config > backend.hcl
#   echo 'key = "engine/terraform.tfstate"' >> backend.hcl
bucket       = "a2i-tfstate-123456789012-us-east-1"
region       = "us-east-1"
encrypt      = true
kms_key_id   = "arn:aws:kms:us-east-1:123456789012:key/00000000-0000-0000-0000-000000000000"
use_lockfile = true
key          = "engine/terraform.tfstate"
