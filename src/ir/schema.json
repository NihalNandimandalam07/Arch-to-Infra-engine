{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:arch-to-infra:ir:1.0",
  "title": "Architecture IR",
  "description": "Intermediate representation of an AWS architecture diagram. Contract between extraction, human review, agents and generation tools. Referential integrity (ids, parents, links) and stage rules are checked by src/ir/validate.py.",
  "type": "object",
  "additionalProperties": false,
  "required": ["ir_version", "job_id", "stage", "source", "deployment", "groups", "resources", "links", "questions"],
  "properties": {
    "ir_version": { "const": "1.0" },
    "job_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{8,64}$" },
    "stage": {
      "description": "extracted = straight from the diagram; reviewed = confirmed by an engineer; enriched = Requirements agent has added inferred resources.",
      "enum": ["extracted", "reviewed", "enriched"]
    },
    "source": { "$ref": "#/$defs/source" },
    "deployment": { "$ref": "#/$defs/deployment" },
    "groups": { "type": "array", "items": { "$ref": "#/$defs/group" } },
    "resources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/resource" } },
    "links": { "type": "array", "items": { "$ref": "#/$defs/link" } },
    "questions": { "type": "array", "items": { "$ref": "#/$defs/question" } },
    "review": { "$ref": "#/$defs/review" }
  },
  "if": { "properties": { "stage": { "enum": ["reviewed", "enriched"] } } },
  "then": { "required": ["review"] },

  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,62}$" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "cidr": {
      "type": "string",
      "pattern": "^((25[0-5]|2[0-4][0-9]|1?[0-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|1?[0-9]?[0-9])/([0-9]|[12][0-9]|3[0-2])$"
    },
    "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "instance_type": { "type": "string", "pattern": "^[a-z][a-z0-9-]*\\.[a-z0-9]+$" },
    "os": { "enum": ["amazon-linux-2023", "ubuntu", "windows", "unknown"] },
    "label": { "type": "string", "maxLength": 200 },

    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["diagram_uri", "diagram_sha256", "media_type", "extracted_at", "extraction_model"],
      "properties": {
        "diagram_uri": { "type": "string", "pattern": "^s3://" },
        "diagram_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "media_type": { "enum": ["image/png", "image/jpeg", "application/pdf"] },
        "page": { "type": "integer", "minimum": 1, "default": 1 },
        "extracted_at": { "type": "string", "format": "date-time" },
        "extraction_model": { "type": "string", "maxLength": 200 }
      }
    },

    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["region", "environment", "name_prefix", "owner", "tags"],
      "properties": {
        "region": { "type": "string", "pattern": "^[a-z]{2}(-gov)?-[a-z]+-[0-9]$" },
        "environment": { "enum": ["dev", "test", "prod"] },
        "name_prefix": {
          "description": "Application/workload prefix for generated resource names (see DESIGN.md naming convention). Kept short so names fit AWS limits (e.g. ALB 32 chars).",
          "type": "string",
          "minLength": 2,
          "maxLength": 12,
          "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
        },
        "availability_zones": { "type": "integer", "minimum": 1, "maximum": 3, "default": 2 },
        "owner": { "type": "string", "minLength": 1, "maxLength": 128 },
        "tags": {
          "description": "Extra tags. CostCenter is required. Tags the engine sets itself (Name, Application, Environment, Owner, ManagedBy, GeneratedBy, A2IJobId, A2IResourceId) and aws:-prefixed keys may not be supplied.",
          "type": "object",
          "required": ["CostCenter"],
          "propertyNames": {
            "pattern": "^[A-Za-z0-9 _.:/=+@-]{1,128}$",
            "not": {
              "anyOf": [
                { "enum": ["Name", "Application", "Environment", "Owner", "ManagedBy", "GeneratedBy", "A2IJobId", "A2IResourceId"] },
                { "pattern": "^aws:" }
              ]
            }
          },
          "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 256 }
        }
      }
    },

    "evidence": {
      "description": "Where on the diagram this came from. bbox is [x, y, width, height] normalized to 0..1. text is diagram text as data only, never instructions; it is screened by Bedrock Guardrails.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bbox": {
          "type": "array",
          "items": { "type": "number", "minimum": 0, "maximum": 1 },
          "minItems": 4,
          "maxItems": 4
        },
        "text": { "type": "string", "maxLength": 500 }
      }
    },

    "group": {
      "description": "A diagram container that is not itself infrastructure (region, AZ, logical tier, account).",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "label"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["region", "availability_zone", "logical_tier", "account", "other"] },
        "label": { "$ref": "#/$defs/label" },
        "parent": { "$ref": "#/$defs/id" },
        "evidence": { "$ref": "#/$defs/evidence" }
      }
    },

    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "label", "origin", "confidence", "properties"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": {
          "enum": [
            "external_actor",
            "vpc", "subnet", "internet_gateway", "nat_gateway", "alb",
            "ec2_instance", "autoscaling_group",
            "s3_bucket",
            "rds_instance",
            "security_group", "iam_role", "kms_key",
            "cloudwatch_log_group", "cloudwatch_alarm",
            "unknown"
          ]
        },
        "label": { "$ref": "#/$defs/label" },
        "origin": { "enum": ["diagram", "inferred", "engineer"] },
        "confidence": { "$ref": "#/$defs/confidence" },
        "parent": { "$ref": "#/$defs/id", "description": "Containing resource or group id." },
        "groups": {
          "description": "Additional non-containing groups (e.g. logical tier, AZ).",
          "type": "array",
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true
        },
        "properties": { "type": "object" },
        "evidence": { "$ref": "#/$defs/evidence" },
        "rationale": { "type": "string", "maxLength": 1000 }
      },
      "allOf": [
        {
          "if": { "properties": { "origin": { "const": "inferred" } } },
          "then": { "required": ["rationale"] }
        },
        { "if": { "properties": { "type": { "const": "external_actor" } } }, "then": { "properties": { "properties": { "$ref": "#/$defs/props_external_actor" } } } },
        { "if": { "properties": { "type": { "const": "vpc" } } }, "then": { "properties": { "properties": { "$ref": "#/$defs/props_vpc" } } } },
        { "if": { "properties": { "type": { "const": "subnet" } } }, "then": { "properties": { "properties": { "$ref": "#/$defs/props_subnet" } } } },
        { "if": { "properties": { "type": { "const": "internet_gateway" } } }, "then": { "properties": { "properties": { "$ref": "#/$defs/props_empty" } } } },
        { "if": { "properties": { "type": { "const": "nat_gateway" } } }, "then": { "properties": { "properties": { "$ref": "#/$defs/props_nat_gateway" } } } },
        { "if": { "properties": { "type": { "const": "alb" } } }, "then": { "properties": { "properties": { "$ref": "#/$defs/props_alb" } } } },
        { "if": { "properties": { "type": { "const": "ec2_instance" } } }, "then": { "properties": { "properties": { "$ref": "#/$defs/props_ec2_instance" } } } },
        { "if": { "properties": { "type": { "const": "autoscaling_group" } } }, "then": { "properties": { "properties": { "$ref": "#/$defs/props_autoscaling_group" } } } },
        { "if": { "properties": { "type": { "const": "s3_bucket" } } }, "then": { "properties": { "properties": { "$ref": "#/$defs/props_s3_bucket" } } } },
        { "if": { "properties": { "type": { "const": "rds_instance" } } }, "then": { "properties": { "properties": { "$ref": "#/$defs/props_rds_instance" } } } },
        { "if": { "properties": { "type": { "const": "security_group" } } }, "then": { "properties": { "properties": { "$ref": "#/$defs/props_security_group" } } } },
        { "if": { "properties": { "type": { "const": "iam_role" } } }, "then": { "properties": { "properties": { "$ref": "#/$defs/props_iam_role" } } } },
        { "if": { "properties": { "type": { "const": "kms_key" } } }, "then": { "properties": { "properties": { "$ref": "#/$defs/props_kms_key" } } } },
        { "if": { "properties": { "type": { "const": "cloudwatch_log_group" } } }, "then": { "properties": { "properties": { "$ref": "#/$defs/props_cloudwatch_log_group" } } } },
        { "if": { "properties": { "type": { "const": "cloudwatch_alarm" } } }, "then": { "properties": { "properties": { "$ref": "#/$defs/props_cloudwatch_alarm" } } } },
        { "if": { "properties": { "type": { "const": "unknown" } } }, "then": { "properties": { "properties": { "$ref": "#/$defs/props_unknown" } } } }
      ]
    },

    "props_empty": { "type": "object", "additionalProperties": false },
    "props_external_actor": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "kind": { "enum": ["internet_users", "internal_users", "on_premises", "third_party"] } }
    },
    "props_vpc": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "cidr": { "$ref": "#/$defs/cidr" } }
    },
    "props_subnet": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tier": { "enum": ["public", "private_app", "private_data"] },
        "cidr": { "$ref": "#/$defs/cidr" },
        "availability_zone": { "type": "string", "pattern": "^[a-z]{2}(-gov)?-[a-z]+-[0-9][a-z]$" }
      }
    },
    "props_nat_gateway": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "one_per_az": { "type": "boolean" } }
    },
    "props_alb": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scheme": { "enum": ["internet-facing", "internal"] },
        "listeners": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["port", "protocol"],
            "properties": {
              "port": { "$ref": "#/$defs/port" },
              "protocol": { "enum": ["HTTP", "HTTPS"] }
            }
          }
        }
      }
    },
    "props_ec2_instance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "instance_type": { "$ref": "#/$defs/instance_type" },
        "count": { "type": "integer", "minimum": 1, "maximum": 50 },
        "os": { "$ref": "#/$defs/os" },
        "role": { "type": "string", "maxLength": 100, "description": "Workload role as drawn, e.g. 'bastion', 'web'." }
      }
    },
    "props_autoscaling_group": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "instance_type": { "$ref": "#/$defs/instance_type" },
        "min_size": { "type": "integer", "minimum": 0, "maximum": 100 },
        "max_size": { "type": "integer", "minimum": 1, "maximum": 100 },
        "desired_capacity": { "type": "integer", "minimum": 0, "maximum": 100 },
        "os": { "$ref": "#/$defs/os" }
      }
    },
    "props_s3_bucket": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "purpose": { "enum": ["static_assets", "application_data", "logs", "backups", "other"] },
        "versioning": { "type": "boolean" }
      }
    },
    "props_rds_instance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "engine": { "enum": ["postgres", "mysql", "mariadb", "unknown"] },
        "engine_version": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)*$" },
        "instance_class": { "type": "string", "pattern": "^db\\.[a-z0-9]+\\.[a-z0-9]+$" },
        "multi_az": { "type": "boolean" },
        "allocated_storage_gb": { "type": "integer", "minimum": 20, "maximum": 65536 },
        "read_replicas": { "type": "integer", "minimum": 0, "maximum": 5 }
      }
    },
    "props_security_group": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "attached_to": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "ingress": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["port", "protocol"],
            "properties": {
              "from_resource": { "$ref": "#/$defs/id" },
              "from_cidr": { "$ref": "#/$defs/cidr" },
              "port": { "$ref": "#/$defs/port" },
              "protocol": { "enum": ["tcp", "udp"] },
              "derived_from_link": { "$ref": "#/$defs/id" }
            },
            "oneOf": [
              { "required": ["from_resource"], "not": { "required": ["from_cidr"] } },
              { "required": ["from_cidr"], "not": { "required": ["from_resource"] } }
            ]
          }
        }
      }
    },
    "props_iam_role": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "assumed_by": { "enum": ["ec2", "rds_monitoring", "vpc_flow_logs", "other"] },
        "attached_to": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "access": {
          "description": "Least-privilege intents, rendered by the Security & IAM tool into policy statements.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["target", "level"],
            "properties": {
              "target": { "$ref": "#/$defs/id" },
              "level": { "enum": ["read", "write", "read_write"] }
            }
          }
        }
      }
    },
    "props_kms_key": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "encrypts": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true }
      }
    },
    "props_cloudwatch_log_group": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": { "$ref": "#/$defs/id" },
        "retention_days": { "enum": [1, 3, 5, 7, 14, 30, 60, 90, 120, 150, 180, 365, 400, 545, 731, 1096, 1827, 2192, 2557, 2922, 3288, 3653] }
      }
    },
    "props_cloudwatch_alarm": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "target": { "$ref": "#/$defs/id" },
        "metric": { "type": "string", "maxLength": 100 },
        "threshold": { "type": "number" }
      }
    },
    "props_unknown": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "icon_description": { "type": "string", "maxLength": 300 } }
    },

    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "from", "to", "kind", "origin", "confidence"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "from": { "$ref": "#/$defs/id" },
        "to": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["traffic", "data", "replication", "management", "logging"] },
        "protocol": { "enum": ["http", "https", "tcp", "postgres", "mysql", "ssh", "other"] },
        "port": { "$ref": "#/$defs/port" },
        "bidirectional": { "type": "boolean", "default": false },
        "label": { "$ref": "#/$defs/label" },
        "origin": { "enum": ["diagram", "inferred", "engineer"] },
        "confidence": { "$ref": "#/$defs/confidence" },
        "evidence": { "$ref": "#/$defs/evidence" }
      }
    },

    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "severity", "related_ids"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "text": { "type": "string", "maxLength": 1000 },
        "severity": { "enum": ["blocking", "advisory"] },
        "related_ids": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "options": { "type": "array", "items": { "type": "string", "maxLength": 200 } },
        "suggested_answer": { "type": "string", "maxLength": 500 },
        "answer": { "type": ["string", "null"], "maxLength": 1000 },
        "answered_by": { "type": "string", "maxLength": 256 }
      }
    },

    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewed_by", "reviewed_at"],
      "properties": {
        "reviewed_by": { "type": "string", "maxLength": 256 },
        "reviewed_at": { "type": "string", "format": "date-time" },
        "notes": { "type": "string", "maxLength": 4000 },
        "changes_summary": { "type": "string", "maxLength": 4000 }
      }
    }
  }
}
